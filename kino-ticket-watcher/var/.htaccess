# Zweite Sicherung: Die Anwendung soll ohnehin ausserhalb des Document Root
# liegen. Falls das bei IONOS nicht moeglich ist, sperrt diese Datei den
# direkten Browserzugriff auf Code, Konfiguration und Zustand.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
