# Zweite Sicherung: Die Anwendung soll ausserhalb des Document Root liegen.
# Falls das nicht moeglich ist, sperrt diese Datei den Browserzugriff auf
# Code, Konfiguration, Zustand und die abgelegten Briefe.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
